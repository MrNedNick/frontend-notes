---
import Base from '../layouts/base.astro'
import NoteCard from '../components/note-card.astro'
import { publishedNotes } from '../lib/notes'
import { STACKS } from '../data/stacks'
import { formatBytes } from '../lib/format'

const notes = await publishedNotes()
const latest = notes.slice(0, 4)
const measured = STACKS.filter((stack) => stack.jsBytes !== null)
const lightest = measured.reduce((min, stack) => (stack.jsBytes! < min.jsBytes! ? stack : min))
const heaviest = measured.reduce((max, stack) => (stack.jsBytes! > max.jsBytes! ? stack : max))
---

<Base
  title="Frontend Notes — what five stacks taught me"
  description="Short notes from building the same kind of thing five times: Astro, SvelteKit, Angular, React with TanStack and Vue. With numbers from real builds."
  section="home"
>
  <section class="pb-4">
    <p class="text-sm font-medium text-accent">Notebook</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">
      Five stacks, one afternoon of measuring
    </h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-soft">
      I built five small products on five stacks I had not used before, and wrote down what
      actually happened: the bugs that cost an hour, the ones that only appear on a shared link,
      and how much JavaScript each framework hands the browser before it draws anything. Every
      number here comes from a build on this laptop, not from someone else's blog post.
    </p>

    <div class="mt-6 flex flex-wrap gap-3">
      <a
        href="/stacks"
        class="rounded-full bg-accent px-4 py-2 text-sm font-medium text-on-accent hover:opacity-90"
      >
        See the comparison
      </a>
      <a
        href="/notes"
        class="rounded-full border border-line px-4 py-2 text-sm font-medium hover:border-accent hover:text-accent"
      >
        All {notes.length} notes
      </a>
    </div>
  </section>

  <section class="mt-10 grid gap-3 sm:grid-cols-3" aria-label="Highlights">
    <div class="rounded-xl border border-line bg-surface p-4">
      <p class="text-xs text-ink-soft">Lightest first load</p>
      <p class="mt-1 text-xl font-semibold">{formatBytes(lightest.jsBytes!)}</p>
      <p class="mt-1 text-xs text-ink-soft">{lightest.stack}</p>
    </div>
    <div class="rounded-xl border border-line bg-surface p-4">
      <p class="text-xs text-ink-soft">Heaviest first load</p>
      <p class="mt-1 text-xl font-semibold">{formatBytes(heaviest.jsBytes!)}</p>
      <p class="mt-1 text-xs text-ink-soft">{heaviest.stack}</p>
    </div>
    <div class="rounded-xl border border-line bg-surface p-4">
      <p class="text-xs text-ink-soft">This page</p>
      <p class="mt-1 text-xl font-semibold">0 kB</p>
      <p class="mt-1 text-xs text-ink-soft">Astro, no islands on it</p>
    </div>
  </section>

  <section class="mt-12">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="text-lg font-semibold">Latest notes</h2>
      <a class="text-sm text-accent hover:underline" href="/notes">All notes →</a>
    </div>
    <div class="mt-4 grid gap-3">
      {latest.map((note) => <NoteCard note={note} />)}
    </div>
  </section>
</Base>
