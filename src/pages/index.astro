---
import { sitePath } from '../lib/path'
import Base from '../layouts/base.astro'
import SymptomCard from '../components/symptom-card.astro'
import CategoryNav from '../components/category-nav.astro'
import { publishedNotes, symptomNotes } from '../lib/notes'

const bugs = await symptomNotes()
const method = (await publishedNotes()).filter((note) => note.data.kind === 'method')
const projects = new Set(bugs.map((note) => note.data.project))
---

<Base
  title="Frontend Notes — bugs filed by what they looked like"
  description="Real bugs from real projects, indexed by the symptom you would search for: a blank screen, a header that hangs in the wrong place, a layout shift on a page that does not move. Each with the cause, the fix and a live demo."
  section="home"
>
  <section>
    <p class="text-sm font-medium text-accent">Symptom → cause</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">
      When the frontend breaks in a strange way
    </h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-soft">
      {bugs.length} bugs from {projects.size} projects of mine, filed under what they looked
      like — not under the API that caused them. Each note goes from the symptom to the cause,
      shows the fix as one diff, and links to the commit and to a live page where the bug is gone.
    </p>
  </section>

  <CategoryNav />

  <section class="mt-6" aria-label="Symptoms">
    <div class="grid gap-3 sm:grid-cols-2">
      {bugs.map((note) => <SymptomCard note={note} />)}
    </div>
  </section>

  <section class="mt-12 grid gap-3 sm:grid-cols-2" aria-label="Elsewhere">
    <a
      href={sitePath('/stacks')}
      class="rounded-xl border border-line bg-surface p-5 transition-colors hover:border-accent"
    >
      <p class="text-sm font-semibold">Five stacks, measured</p>
      <p class="mt-1 text-sm text-ink-soft">
        How much JavaScript Astro, SvelteKit, Angular, React with TanStack and Vue hand the
        browser before the first paint, from real builds.
      </p>
    </a>
    {
      method.map((note) => (
        <a
          href={sitePath(`/notes/${note.id}`)}
          class="rounded-xl border border-line bg-surface p-5 transition-colors hover:border-accent"
        >
          <p class="text-sm font-semibold">{note.data.title}</p>
          <p class="mt-1 text-sm text-ink-soft">{note.data.description}</p>
        </a>
      ))
    }
  </section>
</Base>
