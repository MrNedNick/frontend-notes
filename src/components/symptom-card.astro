---
import { sitePath } from '../lib/path'
import { CATEGORIES } from '../content/schema'
import type { SymptomNote } from '../lib/notes'

interface Props {
  note: SymptomNote
}
const { note } = Astro.props
const { symptom, cause, project, category, timeToFind } = note.data
---

<article class="group relative rounded-xl border border-line bg-surface p-5 transition-colors hover:border-accent">
  <p class="text-xs font-medium uppercase tracking-wide text-accent">{CATEGORIES[category]}</p>
  <h2 class="mt-1.5 text-base font-semibold leading-snug">
    <a href={sitePath(`/notes/${note.id}`)} class="after:absolute after:inset-0 group-hover:text-accent">
      “{symptom}”
    </a>
  </h2>
  <p class="mt-2 text-sm leading-relaxed text-ink-soft"><span class="text-ink">Cause:</span> {cause}</p>
  <p class="mt-3 text-xs text-ink-soft">
    in <span class="text-ink">{project}</span>{timeToFind && <> · found in {timeToFind}</>}
  </p>
</article>
