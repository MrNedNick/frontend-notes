---
import { sitePath } from '../lib/path'
import type { CollectionEntry } from 'astro:content'
import { formatDate } from '../lib/format'

interface Props {
  note: CollectionEntry<'notes'>
}
const { note } = Astro.props
---

<article class="group rounded-xl border border-line bg-surface p-5 transition-colors hover:border-accent">
  <div class="flex items-baseline justify-between gap-4">
    <h3 class="text-base font-semibold">
      <a href={sitePath(`/notes/${note.id}`)} class="after:absolute after:inset-0 group-hover:text-accent">
        {note.data.title}
      </a>
    </h3>
    <time datetime={note.data.date.toISOString()} class="shrink-0 text-xs text-ink-soft">
      {formatDate(note.data.date)}
    </time>
  </div>
  <p class="mt-2 text-sm leading-relaxed text-ink-soft">{note.data.description}</p>
  <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Tags">
    {
      note.data.tags.map((tag) => (
        <li class="rounded-full bg-accent-soft px-2.5 py-0.5 text-xs text-accent">{tag}</li>
      ))
    }
  </ul>
</article>
