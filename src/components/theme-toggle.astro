<button
  type="button"
  id="theme-toggle"
  class="ml-1 grid size-9 place-items-center rounded-full border border-line text-ink-soft hover:text-accent"
  aria-label="Switch theme"
>
  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
    <path class="hidden dark:block" d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1z" />
    <g class="block dark:hidden">
      <path d="M16 12a4 4 0 1 1-8 0 4 4 0 0 1 8 0" />
      <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4" />
    </g>
  </svg>
</button>

<!--
  Inlined on purpose: a note page should make no JavaScript request at all, and
  a few hundred bytes in the HTML beat a round trip for a class on <html>.
-->
<script is:inline>
  const button = document.getElementById('theme-toggle')
  button?.addEventListener('click', () => {
    const root = document.documentElement
    const next = root.classList.contains('dark') ? 'light' : 'dark'
    root.classList.remove('light', 'dark')
    root.classList.add(next)
    root.style.colorScheme = next
    try {
      localStorage.setItem('frontend-notes.theme', next)
    } catch {
      /* private mode: the choice lasts for this page only */
    }
  })
</script>
