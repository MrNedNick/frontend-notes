---
import { sitePath } from '../lib/path'
import Header from '../components/header.astro'
import Footer from '../components/footer.astro'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  /** Absolute path to a generated preview image, when the page has one. */
  ogImage?: string
  /** Marks the notes tab as current. */
  section?: 'notes' | 'stacks' | 'home'
}

const { title, description, ogImage, section = 'home' } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
const image = new URL(sitePath(ogImage ?? '/og/site.png'), Astro.site)
---

<!doctype html>
<html lang="en" class="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={sitePath('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Frontend Notes" href={sitePath('/rss.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />

    <!--
      Runs before the first paint: without it the page renders in the wrong
      scheme for a frame and then flips. Inline on purpose — a request for this
      would be slower than the paint it is preventing.
    -->
    <script is:inline>
      ;(function () {
        try {
          var saved = localStorage.getItem('frontend-notes.theme')
          var dark = window.matchMedia('(prefers-color-scheme: dark)').matches
          var theme = saved === 'light' || saved === 'dark' ? saved : dark ? 'dark' : 'light'
          document.documentElement.classList.remove('light', 'dark')
          document.documentElement.classList.add(theme)
          document.documentElement.style.colorScheme = theme
        } catch (error) {
          document.documentElement.classList.add('light')
        }
      })()
    </script>
  </head>

  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only rounded-br-lg bg-accent px-4 py-2 text-on-accent focus:not-sr-only focus:absolute focus:left-0 focus:top-0 focus:z-50"
    >
      Skip to content
    </a>

    <Header section={section} />

    <main id="main" class="mx-auto w-full max-w-4xl flex-1 px-5 py-10 sm:px-6">
      <slot />
    </main>

    <Footer />
  </body>
</html>
